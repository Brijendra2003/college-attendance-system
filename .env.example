# Copy to .env.local and fill in. Never commit real keys.

# Supabase project (Settings → API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: account provisioning (Auth admin API) and bootstrap scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for scripts (seed:demo, bootstrap:admin). Use the
# Supavisor session pooler string from Settings → Database.
DATABASE_URL=

# ── Local development without Docker (see README) ─────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by `npm run dev:supabase`>
# SUPABASE_SERVICE_ROLE_KEY=<printed by `npm run dev:supabase`>
# DATABASE_URL=postgres://postgres@localhost:54329/cas_dev
